        "content": "def format_currency(amount: float, currency: str = 'USD') -> str:\r\n    \"\"\"Format number as currency string.\"\"\"\r\n    symbols = {'USD': '$', 'EUR': '€', 'GBP': '£'}\r\n    symbol = symbols.get(currency, currency)\r\n    return f'{symbol}{amount:,.2f}'\r\n\r\n\r"
