{
  "manifest_version": 3,
  "name": "ExcaliVault",
  "version": "1.0.0",
  "description": "Save and manage ExcaliDraw canvas snapshots as projects right from the dashboard",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://excalidraw.com/*",
    "https://www.excalidraw.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://excalidraw.com/*",
        "https://www.excalidraw.com/*"
      ],
      "js": ["content.js"],
      "css": ["excalivault.css"],
      "run_at": "document_end"
    }
  ]
}
